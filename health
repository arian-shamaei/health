# ---------------------------------------------------------------- readings


def read_file(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""


def sysctl(name):
    try:
        out = subprocess.run(["sysctl", "-n", name], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             timeout=1).stdout.decode().strip()
        return out
    except (OSError, subprocess.SubprocessError):
        return ""


def read_temp_c():
    """The cpu temperature in C: the first thermal zone on Linux; none means idle (35 C)."""
    for zone in ("thermal_zone0", "thermal_zone1"):
        s = read_file("/sys/class/thermal/%s/temp" % zone).strip()
        if s:
            try:
                return int(s) / 1000.0
            except ValueError:
                pass
    for root, _, files in os.walk("/sys/class/hwmon"):
        for name in files:
            if name.startswith("temp") and name.endswith("_input"):
                s = read_file(os.path.join(root, name)).strip()
                if s:
                    try:
                        return int(s) / 1000.0
                    except ValueError:
                        pass
        break
    return 35.0


def read_load():
    try:
        return os.getloadavg()[0]
    except OSError:
        return 0.0


def read_uptime_s():
    s = read_file("/proc/uptime").split()
    if s:
        return float(s[0])
    m = re.search(r"sec\s*=\s*(\d+)", sysctl("kern.boottime"))      # macOS, BSD
    if m:
        return max(0.0, time.time() - int(m.group(1)))
    return 0.0


def read_mem_mb():
    """(used, total) in MB, used = total - available."""
    vals = {}
    for line in read_file("/proc/meminfo").splitlines():
        k, _, v = line.partition(":")
        if v:
            vals[k] = int(v.split()[0])
    if "MemTotal" in vals and "MemAvailable" in vals:
        t = vals["MemTotal"] // 1024
        return t - vals["MemAvailable"] // 1024, t
    total = sysctl("hw.memsize")                                       # macOS
    if total.isdigit():
        t = int(total) // (1024 * 1024)
        try:
            vm = subprocess.run(["vm_stat"], stdout=subprocess.PIPE, timeout=1).stdout.decode()
            page = int(re.search(r"page size of (\d+)", vm).group(1))
            free = 0
            for key in ("Pages free", "Pages inactive", "Pages speculative"):
                m = re.search(key + r":\s*(\d+)", vm)
                if m:
                    free += int(m.group(1))
            return t - free * page // (1024 * 1024), t
        except (OSError, subprocess.SubprocessError, AttributeError, ValueError):
            return t // 2, t
    return 400, 8000


def read_disk():
    """(free GB, free fraction) of /."""
    try:
        st = os.statvfs("/")
        return st.f_bavail * st.f_frsize / 1e9, st.f_bavail / max(1, st.f_blocks)
    except OSError:
        return 0.0, 0.5


def read_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("10.255.255.255", 1))   # no packet is sent; picks the route
        ip = s.getsockname()[0]
        s.close()
        return ip
    except OSError:
        return ""


def gather():
    now = time.localtime()
    used, total = read_mem_mb()
    free_gb, free_frac = read_disk()
    return {
        "temp": read_temp_c(),
        "load": read_load(),
        "uptime": read_uptime_s(),
        "mem_used": used, "mem_total": total,
        "disk_free_gb": free_gb, "disk_free_frac": free_frac,
        "hour": now.tm_hour, "sec": now.tm_sec,
        "user": os.environ.get("USER") or os.environ.get("LOGNAME") or "someone",
        "host": socket.gethostname().split(".")[0],
        "ip": read_ip(),
        "kernel": os.uname().release,
        "stamp": time.strftime("%a %Y-%m-%d %H:%M", now),
    }


# ---------------------------------------------------------------- the curve

RATIOS = [(2, 3), (3, 4), (3, 5), (4, 5), (5, 6), (5, 7)]


def clamp(x, lo, hi):
    return lo if x < lo else hi if x > hi else x


def params(r, ratio=None):
    """The curve's parameters from the readings. `ratio` overrides the hour's (fa, fb), as
    floats, for the live view gliding from one hour block's ratio to the next."""
    heat = clamp((r["temp"] - 35.0) / 45.0, 0.0, 1.0)                     # 35 C idle, 80 C throttling
    busy = clamp(r["load"] / max(1, os.cpu_count() or 1), 0.0, 1.0)       # load per core
    mem = clamp(r["mem_used"] / max(1, r["mem_total"]), 0.0, 1.0)
    full = clamp(1.0 - r["disk_free_frac"], 0.0, 1.0)
    fa, fb = ratio or RATIOS[(r["hour"] // 4) % len(RATIOS)]
    t_end = 2 * math.pi * 10 / fa                 # ten periods of the slower pendulum
    detune = 2.5 * heat * heat / t_end             # the ratio slips 0 (locked) to 2.5 rad over the trace
    seed = zlib.crc32(("%s@%s" % (r["user"], r["host"])).encode())
    s1 = (seed & 0xFF) / 255.0 * 2 * math.pi
    s2 = ((seed >> 8) & 0xFF) / 255.0 * 2 * math.pi
    up_min = r["uptime"] / 60.0
    return {
        "fx1": fa, "fy1": fb + detune,
        "fx2": fa + 1 + detune * 3, "fy2": fb + 1,
        "px1": math.radians(up_min % 360) + s1,
        "py1": math.radians((up_min * 0.7) % 360) + s2,
        "px2": 2 * math.pi * r["sec"] / 60.0,
        "py2": 2 * math.pi * r["sec"] / 60.0 + math.pi / 2,
        "amp2": mem,                                            # 0: pure Lissajous, 1: wobble as big as the curve
        "damp": -math.log(1.0 - 0.6 * busy) / t_end,            # last lap 100 % (idle) to 40 % (one load per core)
        "t_end": t_end,
        "base_hue": 240.0 * (1.0 - heat),                       # blue to red
        "sweep": 20.0 + 300.0 * full,                           # one hue to the whole wheel
    }


def trace(p, n=14000):
    """Points (x, y, u) with x, y in [-1, 1] and u in [0, 1] along the trace. Each sine is a
    unit phasor turned by a constant complex step, and the damping one real factor, so a
    point costs four complex multiplies instead of four sines and an exponential."""
    t_end = p["t_end"]
    a1 = 1.0 / (1.0 + p["amp2"])
    a2 = p["amp2"] / (1.0 + p["amp2"])
    dt = t_end / (n - 1)
    zx1 = complex(math.cos(p["px1"]), math.sin(p["px1"]))
    zy1 = complex(math.cos(p["py1"]), math.sin(p["py1"]))
    zx2 = complex(math.cos(p["px2"]), math.sin(p["px2"]))
    zy2 = complex(math.cos(p["py2"]), math.sin(p["py2"]))
    sx1 = complex(math.cos(p["fx1"] * dt), math.sin(p["fx1"] * dt))
    sy1 = complex(math.cos(p["fy1"] * dt), math.sin(p["fy1"] * dt))
    sx2 = complex(math.cos(p["fx2"] * dt), math.sin(p["fx2"] * dt))
    sy2 = complex(math.cos(p["fy2"] * dt), math.sin(p["fy2"] * dt))
    e = 1.0
    de = math.exp(-p["damp"] * dt)
    du = 1.0 / (n - 1)
    pts = []
    append = pts.append
    for i in range(n):
        append((e * (a1 * zx1.imag + a2 * zx2.imag), e * (a1 * zy1.imag + a2 * zy2.imag), i * du))
        zx1 *= sx1; zy1 *= sy1; zx2 *= sx2; zy2 *= sy2
        e *= de
    return pts


# ---------------------------------------------------------------- render

def hsv_to_rgb(h, s, v):
    h = (h % 360.0) / 60.0
    i = int(h)
    f = h - i
    p = v * (1 - s)
    q = v * (1 - s * f)
    t = v * (1 - s * (1 - f))
    r, g, b = [(v, t, p), (q, v, p), (p, v, t), (p, q, v), (t, p, v), (v, p, q)][i % 6]
    return int(r * 255 + 0.5), int(g * 255 + 0.5), int(b * 255 + 0.5)


BITS = [[0x01, 0x08], [0x02, 0x10], [0x04, 0x20], [0x40, 0x80]]


def render(pts, cols, rows, p):
    """Braille cells, each coloured by the mean position along the trace of its dots."""
    w, h = cols * 2, rows * 4
    cells = [[0] * cols for _ in range(rows)]
    usum = [[0.0] * cols for _ in range(rows)]
    ucnt = [[0] * cols for _ in range(rows)]
    for x, y, u in pts:
        dx = int((x * 0.5 + 0.5) * (w - 1) + 0.5)
        dy = int((0.5 - y * 0.5) * (h - 1) + 0.5)
        cx, cy = dx // 2, dy // 4
        cells[cy][cx] |= BITS[dy % 4][dx % 2]
        usum[cy][cx] += u
        ucnt[cy][cx] += 1
    lines = []
    for cy in range(rows):
        out = []
        last = None
        for cx in range(cols):
            m = cells[cy][cx]
            if not m:
                if last is not None:
                    out.append("\x1b[0m")
                    last = None
                out.append(" ")
                continue
            u = usum[cy][cx] / ucnt[cy][cx]
            rgb = hsv_to_rgb(p["base_hue"] + p["sweep"] * u, 0.85, 0.55 + 0.45 * (1 - u))
            code = "\x1b[38;2;%d;%d;%dm" % rgb
            if code != last:
                out.append(code)
                last = code
            out.append(chr(0x2800 + m))
        if last is not None:
            out.append("\x1b[0m")
        lines.append("".join(out))
    return lines


def write_png(path, w, h, raw, palette):
    """An 8-bit palette PNG: `raw` is h rows of (filter byte + w indices), `palette` the
    256 RGB triples. One byte a pixel and a fast deflate: the image is mostly black."""
    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    png = (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 3, 0, 0, 0))
           + chunk(b"PLTE", palette) + chunk(b"IDAT", zlib.compress(bytes(raw), 1)) + chunk(b"IEND", b""))
    with open(path, "wb") as f:
        f.write(png)


def render_png(pts, p, path, w=1200, h=600, dot=3):
    """The trace as coloured dots on black, the look of the Braille drawing at pixel scale.
    Index 0 is black; 1..255 is the colour along the trace, so each dot is one slice write."""
    palette = bytearray(3)
    for k in range(1, 256):
        u = (k - 1) / 254.0
        palette += bytes(hsv_to_rgb(p["base_hue"] + p["sweep"] * u, 0.85, 0.6 + 0.4 * (1 - u)))
    stride = w + 1                                   # one filter byte (0) leads each row
    buf = bytearray(stride * h)
    marks = [bytes([k]) * dot for k in range(256)]
    xs = w - 1 - dot
    ys = h - 1 - dot
    for x, y, u in pts:
        px = int((x * 0.5 + 0.5) * xs + 0.5)
        py = int((0.5 - y * 0.5) * ys + 0.5)
        mark = marks[1 + int(u * 254)]
        base = py * stride + 1 + px
        for dy in range(dot):
            i = base + dy * stride
            buf[i:i + dot] = mark
    write_png(path, w, h, buf, bytes(palette))


# ---------------------------------------------------------------- the terminal

DEBUG = bool(os.environ.get("HEALTH_DEBUG"))
DA1 = rb"\x1b\[\?[0-9;]*c"


def winsize():
    """(rows, cols, xpix, ypix) of the controlling terminal."""
    try:
        fd = os.open("/dev/tty", os.O_RDONLY | os.O_NOCTTY)
        try:
            rows, cols, xpix, ypix = struct.unpack("HHHH", fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8))
        finally:
            os.close(fd)
        if rows and cols:
            return rows, cols, xpix, ypix
        return 24, 80, 0, 0
    except OSError:
        try:
            ts = os.get_terminal_size()
            return ts.lines, ts.columns, 0, 0
        except OSError:
            return 24, 80, 0, 0


def ask(query, timeout=0.6):
    """Send `query` plus DA1 to the terminal; return everything read up to the DA1 reply."""
    try:
        fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
    except OSError:
        return b""
    buf = b""
    try:
        old = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            os.write(fd, query + b"\x1b[c")
            deadline = time.monotonic() + timeout
            while True:
                left = deadline - time.monotonic()
                if left <= 0:
                    break
                r, _, _ = select.select([fd], [], [], left)
                if not r:
                    break
                buf += os.read(fd, 256)
                if re.search(DA1, buf):
                    break
        finally:
            termios.tcsetattr(fd, termios.TCSANOW, old)
    except (termios.error, OSError):
        pass
    finally:
        os.close(fd)
    if DEBUG:
        sys.stderr.write("health: asked %r, got %r\n" % (query, buf))
    return buf


def probe():
    """(kitty_ok, sixel_ok) from the terminal, or (False, False) when it cannot be asked."""
    buf = ask(b"\x1b_Gi=31,s=1,v=1,a=q,t=d,f=24;AAAA\x1b\\")
    kitty = b"_Gi=31;OK" in buf
    m = re.search(rb"\x1b\[\?([0-9;]*)c", buf)
    sixel = bool(m) and "4" in m.group(1).decode().split(";")
    return kitty, sixel


def have(cmd):
    for d in os.environ.get("PATH", "").split(os.pathsep):
        if os.access(os.path.join(d, cmd), os.X_OK):
            return os.path.join(d, cmd)
    return None


def choose_format():
    """kitty, iterm, sixels (needs chafa) or None, from the environment first (an ssh
    client forwarding TERM_PROGRAM / WT_SESSION), then by asking the terminal; tmux
    swallows the query, hence the environment first."""
    forced = os.environ.get("HEALTH_FORMAT")
    if forced:
        return forced if forced in ("kitty", "iterm", "sixels") else None
    if not sys.stdout.isatty():
        return None
    env = os.environ
    prog = env.get("TERM_PROGRAM", "")
    name = prog + ":" + env.get("LC_TERMINAL", "")
    term = env.get("TERM", "")
    if env.get("WT_SESSION"):
        return "sixels" if have("chafa") else None
    if prog in ("ghostty", "WezTerm", "tmux") or "kitty" in term or "ghostty" in term:
        return "kitty"
    if "iTerm" in name:
        return "iterm"
    kitty, sixel = probe()
    if kitty:
        return "kitty"
    if sixel and have("chafa"):
        return "sixels"
    return None


def tmux_wrap(seq):
    return b"\x1bPtmux;" + seq.replace(b"\x1b", b"\x1b\x1b") + b"\x1b\\"


