def kitty_png(path, in_tmux, box, image_id):
    """Send the PNG over the Kitty graphics protocol, fitted to `box` = (cols, rows) with
    its aspect kept, as image `image_id`, placed with Unicode placeholders so that tmux
    and the terminal own it like text (WezTerm, which does not place placeholders, gets
    a direct placement). The PNG itself goes over (f=100): about 100 KB a frame."""
    rows, cols, xpix, ypix = winsize()
    with open(path, "rb") as f:
        head = f.read(24)
        f.seek(0)
        data = base64.b64encode(f.read())
    w, h = struct.unpack(">II", head[16:24])
    cell_w = xpix / cols if xpix and cols else 10.0
    cell_h = ypix / rows if ypix and rows else 20.0
    box_c, box_r = min(box[0], cols), min(box[1], rows)
    scale = min(box_c * cell_w / w, box_r * cell_h / h)
    c = max(1, min(box_c, round(w * scale / cell_w)))
    r = max(1, min(box_r, round(h * scale / cell_h)))
    chunks = [data[i:i + 4096] for i in range(0, len(data), 4096)]
    seqs = []
    placeholders = in_tmux or os.environ.get("TERM_PROGRAM", "") != "WezTerm"
    for i, chunk in enumerate(chunks):
        ctrl = b"m=%d" % (0 if i == len(chunks) - 1 else 1)
        if i == 0:
            if placeholders:
                ctrl = b"a=T,U=1,i=%d,f=100,q=2,c=%d,r=%d," % (image_id, c, r) + ctrl
            else:
                ctrl = b"a=T,i=%d,f=100,q=2,C=1,c=%d,r=%d," % (image_id, c, r) + ctrl
        seqs.append(b"\x1b_G" + ctrl + b";" + chunk + b"\x1b\\")
    if placeholders:
        c = min(c, cols - 1, len(DIACRITICS))
        r = min(r, len(DIACRITICS))
        rows_out = []
        for row in range(r):
            cells = "".join(chr(0x10EEEE) + chr(DIACRITICS[row]) + chr(DIACRITICS[col]) for col in range(c))
            rows_out.append(("\x1b[38;5;%dm" % image_id) + cells + "\x1b[39m")
        out = b"".join(tmux_wrap(q) if in_tmux else q for q in seqs) + ("\r\n".join(rows_out) + "\r\n").encode()
    else:
        out = b"".join(seqs)
    if DEBUG:
        sys.stderr.write("health: kitty png %dx%d px -> %dx%d cells (cell %.1fx%.1f px, tmux=%s, placeholders=%s, %d bytes)\n"
                         % (w, h, c, r, cell_w, cell_h, in_tmux, placeholders, len(out)))
    sys.stdout.buffer.write(out)
    sys.stdout.flush()
    return True


def iterm_png(path, box):
    """Send the PNG over the iTerm2 inline-image protocol, fitted to `box` = (cols, rows)."""
    with open(path, "rb") as f:
        data = base64.b64encode(f.read())
    seq = b"\x1b]1337;File=inline=1;width=%d;height=%d;preserveAspectRatio=1:" % box + data + b"\x07"
    sys.stdout.buffer.write(seq)
    sys.stdout.flush()
    return True


def set_pixel_size():
    """For sixel: learn the window's pixel size from the terminal and store it in the pty
    (Windows OpenSSH reports a console size that does not follow the window)."""
    try:
        fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
    except OSError:
        return
    try:
        rows, cols, xpix, ypix = struct.unpack("HHHH", fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8))
        xpix = ypix = 0
        buf = ask(b"\x1b[14t\x1b[16t")
        m = re.search(rb"\x1b\[4;(\d+);(\d+)t", buf)        # text area: height ; width
        if m:
            ypix, xpix = int(m.group(1)), int(m.group(2))
        else:
            m = re.search(rb"\x1b\[6;(\d+);(\d+)t", buf)    # one cell: height ; width
            if m:
                ypix, xpix = int(m.group(1)) * rows, int(m.group(2)) * cols
        if xpix and ypix:
            fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, xpix, ypix))
    except (OSError, struct.error):
        pass
    finally:
        os.close(fd)


class Keys:
    """The controlling terminal in cbreak mode for the whole live view (set once, not per
    frame: a key that arrives between two frames while the terminal is back in canonical
    mode would wait for a newline on Linux), restored on close."""

    def __init__(self):
        self.fd = None
        self.old = None
        try:
            self.fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
            self.old = termios.tcgetattr(self.fd)
            tty.setcbreak(self.fd)
        except (termios.error, OSError):
            if self.fd is not None:
                os.close(self.fd)
            self.fd = None

    def wait(self, seconds):
        """Wait, or return early with the key pressed (bytes)."""
        if self.fd is None:
            time.sleep(seconds)
            return b""
        r, _, _ = select.select([self.fd], [], [], seconds)
        return os.read(self.fd, 16) if r else b""

    def close(self):
        if self.fd is not None:
            try:
                termios.tcsetattr(self.fd, termios.TCSANOW, self.old)
            except termios.error:
                pass
            os.close(self.fd)
            self.fd = None


MUTED = "\x1b[38;2;90;90;100m"
DIM = "\x1b[38;2;150;150;160m"
BOLD = "\x1b[1;97m"
RESET = "\x1b[0m"


def status_line(raw, fa, fb):
    return ("%.0f°C   load %.2f   %d / %d MB   %.0f GB free   %s:%s   q quits"
            % (raw["temp"], raw["load"], raw["mem_used"], raw["mem_total"], raw["disk_free_gb"], fa, fb))


# ---------------------------------------------------------------- the live view

TAU = {"temp": 3.0, "mem_used": 3.0, "load": 2.0, "fa": 20.0, "fb": 20.0}


class Eased:
    """Each reading eases toward the sensor with a time constant, so the sensor's noise
    (a cpu sensor flickers over 3 C from frame to frame) never reaches the figure and a
    real change arrives over a few seconds, the way a machine warms and cools."""

    def __init__(self):
        self.v = {}

    def __call__(self, key, x, dt):
        v = self.v.get(key, x)
        v += (x - v) * (1.0 - math.exp(-dt / TAU[key]))
        self.v[key] = v
        return v


def frame_params(raw, ease, dt, now):
    """The curve's parameters for one live frame: eased readings, the phase on seconds."""
    r = dict(raw)
    for key in ("temp", "mem_used", "load"):
        r[key] = ease(key, raw[key], dt)
    fa, fb = RATIOS[(raw["hour"] // 4) % len(RATIOS)]
    p = params(r, (ease("fa", fa, dt), ease("fb", fb, dt)))
    up_s = r["uptime"]
    p["px1"] = math.radians((up_s * 6.0) % 360) + (p["px1"] - math.radians((up_s / 60.0) % 360))
    p["px2"] = 2 * math.pi * (now % 60) / 60.0
    p["py2"] = p["px2"] + math.pi / 2
    return p, fa, fb


def live(fps=10.0, braille=False, source=gather):
    """The figure alone, as large as the window, redrawn from fresh readings about `fps`
    times a second on the alternate screen until q."""
    fmt = None if braille else choose_format()
    if fmt == "sixels":
        set_pixel_size()
    rows, cols, xpix, ypix = winsize()
    cell_w = xpix / cols if xpix and cols else 10.0
    cell_h = ypix / rows if ypix and rows else 20.0
    box_c, box_r = cols, rows - 1                      # one row for the readings
    w = int(min(1600, box_c * cell_w, box_r * cell_h * 2))     # the frame: 2:1, as large as the box
    w = max(200, w - w % 2)
    h = w // 2
    in_tmux = os.environ.get("TERM_PROGRAM") == "tmux" or bool(os.environ.get("TMUX"))
    path = os.path.join(os.environ.get("TMPDIR", "/tmp"), "health-%d.png" % os.getpid())

    def apc(seq):
        if in_tmux:
            seq = tmux_wrap(seq)
        os.write(sys.stdout.fileno(), seq)

    out = sys.stdout
    out.write("\x1b[?1049h\x1b[?25l\x1b[H\x1b[2J")
    out.flush()
    shown = None
    next_frame = time.monotonic()
    ease = Eased()
    last = time.monotonic()
    keys = Keys()
    try:
        while True:
            next_frame += 1.0 / fps                  # a fixed beat, so the turn is even
            now_m = time.monotonic()
            dt = min(1.0, max(0.0, now_m - last))
            last = now_m
            raw = source()
            p, fa, fb = frame_params(raw, ease, dt, time.time())
            pts = trace(p, n=12000)
            out.write("\x1b[H")
            out.flush()
            if fmt == "kitty":
                render_png(pts, p, path, w, h, dot=3)
                new_id = 1 if shown != 1 else 2
                if kitty_png(path, in_tmux, (box_c, box_r), new_id):
                    if shown:
                        apc(b"\x1b_Ga=d,d=I,i=%d\x1b\\" % shown)
                    shown = new_id
            elif fmt == "iterm":
                render_png(pts, p, path, w, h, dot=3)
                iterm_png(path, (box_c, box_r))
            elif fmt == "sixels":
                render_png(pts, p, path, w, h, dot=3)
                subprocess.run(["chafa", "--format=sixels", "--size=%dx%d" % (box_c, box_r), path])
            else:
                fig = render(pts, max(20, cols - 2), max(5, box_r - 1), p)
                out.write("\n".join(" " + line for line in fig) + "\n")
            status = status_line(raw, fa, fb)
            out.write("\x1b[%d;1H\x1b[2K%s %s%s" % (rows, MUTED, status[:cols - 2], RESET))
            out.flush()
            key = keys.wait(max(0.005, next_frame - time.monotonic()))
            if time.monotonic() > next_frame + 1.0 / fps:
                next_frame = time.monotonic()        # fell behind (a slow link): do not race to catch up
            if key and key.lower().startswith((b"q", b"\x03", b"\x1b")):
                break
    except KeyboardInterrupt:
        pass
    finally:
        keys.close()
        if fmt == "kitty":
            apc(b"\x1b_Ga=d,d=A\x1b\\")
        out.write("\x1b[?25h\x1b[?1049l")
        out.flush()
        try:
            os.unlink(path)
        except OSError:
            pass


# ---------------------------------------------------------------- one drawing

def legend(r):
    up = int(r["uptime"])
    d, h, m = up // 86400, up % 86400 // 3600, up % 3600 // 60
    upstr = "%dd %dh %dm" % (d, h, m) if d else "%dh %dm" % (h, m)
    W = 46
    rule = MUTED + "─" * W + RESET

    def kv(label, value, lw=8, vw=None):
        s = "%s%s%s%s" % (MUTED, label.ljust(lw), RESET, value)
        if vw is not None:
            s += " " * max(0, vw - len(value))
        return s

    who = "%s@%s" % (r["user"], r["host"])
    head = ("%s%s%s%s@%s%s%s%s" % (BOLD, r["user"], RESET, MUTED, RESET, BOLD, r["host"], RESET)
            + " " * max(2, W - len(who) - len(r["stamp"])) + DIM + r["stamp"] + RESET)
    col = 18
    return [
        head,
        rule,
        kv("uptime", upstr, vw=col) + kv("ip", r["ip"]),
        kv("cpu", "%.0f°C" % r["temp"], vw=col) + kv("load", "%.2f" % r["load"]),
        kv("memory", "%d / %d MB" % (r["mem_used"], r["mem_total"]), vw=col)
        + kv("disk", "%.0f GB free" % r["disk_free_gb"]),
        kv("kernel", r["kernel"]),
    ]


def once(cols, show_legend, braille, source=gather):
    """One Braille drawing from the readings now, with the legend beside it. This is the
    login-screen form: no animation, no pixels, done in well under a tenth of a second."""
    r = source()
    p = params(r)
    leg = legend(r) if show_legend else []
    legend_w = 50 if show_legend else 0
    rows = 16
    avail = cols - legend_w - 4
    below = show_legend and avail < 32
    if below:
        avail = cols - 4
    cw = max(24, min(2 * rows + 8, avail))
    fig = render(trace(p), cw, rows, p)
    out = [""]
    if below:
        out += ["  " + line for line in fig] + [""] + ["  " + line for line in leg]
    else:
        pad = (len(fig) - len(leg)) // 2
        for i, line in enumerate(fig):
            j = i - pad
            out.append("  " + line + "   " + (leg[j] if 0 <= j < len(leg) else ""))
    out.append("")
    sys.stdout.write("\n".join(out) + "\n")


# ---------------------------------------------------------------- figures and the demo

def fake_source(overrides):
    """Readings now, with some replaced (temp=73,load=4.7,mem=0.4,disk=0.8,hour=14)."""
    def source():
        r = gather()
        for k, v in overrides.items():
            if k == "mem":
                r["mem_used"] = int(v * r["mem_total"])
            elif k == "disk":
                r["disk_free_frac"] = 1.0 - v
            elif k in ("hour", "sec"):
                r[k] = int(v)
            elif k == "user":
                r["user"] = v
            elif k == "host":
                r["host"] = v
            else:
                r[k] = float(v)
        return r
    return source


def parse_readings(spec):
    out = {}
    for item in spec.split(","):
        if not item:
            continue
        k, _, v = item.partition("=")
        out[k.strip()] = v.strip() if k.strip() in ("user", "host") else float(v)
    return out


def png_once(path, source, w, h):
    """One frame to a PNG, the live view's form (phase on seconds), from `source`."""
    raw = source()
    p, fa, fb = frame_params(raw, Eased(), 0.0, time.time())
    render_png(trace(p, n=12000), p, path, w, h, dot=max(2, w // 400))
    return status_line(raw, fa, fb)


SCENARIO = [    # (seconds, temp, load per core, mem fraction): a build starts, runs, and the machine cools
    (0.0, 42, 0.05, 0.12), (2.0, 42, 0.05, 0.12), (3.0, 48, 0.8, 0.3), (5.0, 60, 1.0, 0.5),
    (8.0, 73, 1.0, 0.6), (11.0, 75, 1.0, 0.6), (12.0, 66, 0.3, 0.3), (15.0, 50, 0.05, 0.12), (18.0, 42, 0.05, 0.12),
]


def scenario_at(t):
    for (t0, a0, b0, c0), (t1, a1, b1, c1) in zip(SCENARIO, SCENARIO[1:]):
        if t0 <= t <= t1:
            u = (t - t0) / (t1 - t0) if t1 > t0 else 0.0
            return a0 + (a1 - a0) * u, b0 + (b1 - b0) * u, c0 + (c1 - c0) * u
    return SCENARIO[-1][1:]


def demo(outdir, fps, w, h, seconds=None):
    """Frames of a scripted scenario (a build starts and the machine cools) through the
    live view's own frame maker, with the eased readings and the turning phase, so a GIF
    of the real renderer can be made without waiting for a real build. Readings other
    than temperature, load and memory are the machine's own."""
    os.makedirs(outdir, exist_ok=True)
    ease = Eased()
    cores = os.cpu_count() or 1
    total = seconds if seconds is not None else SCENARIO[-1][0]
    n = int(total * fps)
    t0 = time.time()
    base = gather()
    base["disk_free_frac"] = 0.35
    for i in range(n):
        t = i / fps
        temp, busy, mem = scenario_at(t)
        raw = dict(base)
        raw["temp"], raw["load"], raw["mem_used"] = temp, busy * cores, int(mem * raw["mem_total"])
        raw["uptime"] = base["uptime"] + t
        p, fa, fb = frame_params(raw, ease, 1.0 / fps, t0 + t)
        render_png(trace(p, n=12000), p, os.path.join(outdir, "frame-%04d.png" % i), w, h, dot=max(2, w // 400))
        with open(os.path.join(outdir, "frame-%04d.txt" % i), "w") as f:
            f.write(status_line(raw, fa, fb).replace("   q quits", "") + "\n")
    return n


# ---------------------------------------------------------------- main

USAGE = """usage: health [FPS] [--braille]      the figure alone, as large as the window, turning
                                     continuously and redrawn from fresh readings about FPS
                                     times a second (default 10, 0.5 to 20); q quits
       health --once [--no-legend]   one Braille drawing with the readings beside it (a
                                     login screen: instant, no pixels, no animation)
       health --png PATH [--size WxH] [--readings temp=73,load=4.7,mem=0.6,disk=0.8,hour=14]
                                     one frame to a PNG, from the readings now or as given
       health --demo DIR [--fps N] [--size WxH]
                                     frames of a scripted build (frame-NNNN.png + .txt)
       health -h | --help | --version
  --braille draws dots instead of pixels; HEALTH_FORMAT=kitty|iterm|sixels forces a protocol;
  HEALTH_DEBUG=1 logs the terminal's replies on stderr. man health for the full page."""


def main(argv):
    args = list(argv[1:])
    fps = 10.0
    braille = once_mode = show_legend = None
    show_legend = True
    png = demo_dir = None
    size = (1200, 600)
    readings = {}
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-h", "--help"):
            print(USAGE)
            return 0
        elif a == "--version":
            print("health " + VERSION)
            return 0
        elif a == "--braille":
            braille = True
        elif a == "--once":
            once_mode = True
        elif a == "--no-legend":
            show_legend = False
        elif a in ("--png", "--demo", "--size", "--readings", "--fps", "--seconds", "--cols"):
            i += 1
            if i >= len(args):
                sys.stderr.write("health: %s needs a value\n" % a)
                return 2
            v = args[i]
            if a == "--png":
                png = v
            elif a == "--demo":
                demo_dir = v
            elif a == "--size":
                size = tuple(int(x) for x in v.lower().split("x"))
            elif a == "--readings":
                readings = parse_readings(v)
            elif a == "--fps":
                fps = float(v)
            elif a == "--seconds":
                readings["_seconds"] = float(v)
            elif a == "--cols":
                readings["_cols"] = int(v)
        elif a.startswith("-"):
            sys.stderr.write("health: unknown option %s\n%s\n" % (a, USAGE))
            return 2
        else:
            try:
                fps = min(20.0, max(0.5, float(a)))
            except ValueError:
                sys.stderr.write("health: FPS must be a number, not %r\n" % a)
                return 2
        i += 1
    seconds = readings.pop("_seconds", None)
    cols = readings.pop("_cols", None)
    source = fake_source(readings) if readings else gather
    if demo_dir:
        n = demo(demo_dir, fps, size[0], size[1], seconds)
        print("health: %d frames in %s" % (n, demo_dir))
        return 0
    if png:
        print(png_once(png, source, size[0], size[1]))
        return 0
    if once_mode:
        if cols is None:
            try:
                cols = os.get_terminal_size().columns
            except OSError:
                cols = 80
            if cols < 20:
                cols = 80
        once(cols, show_legend, braille, source)
        return 0
    live(fps, bool(braille), source)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
